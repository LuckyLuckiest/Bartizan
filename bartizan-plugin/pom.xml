<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.luckyraven.bartizan</groupId>
        <artifactId>bartizan</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>bartizan-plugin</artifactId>
    <name>Bartizan Plugin</name>
    <description>The Bartizan-${revision}.jar dropped into /plugins beside Keystone-${keystone.version}.jar — standalone weapons, ammunition, wearables and projectile combat.</description>

    <build>
        <finalName>Bartizan-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Keystone is provided (never shaded here) and bartizan-api is our own, so the only
                                 relocation is bStats: Spigot shares classes across plugin classloaders, and
                                 Gangland relocates the same library (gangland-build/pom.xml). -->
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>org.luckyraven.bartizan.dependency.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- bartizan-api must be inside the jar: compile scope. -->
        <dependency>
            <groupId>org.luckyraven.bartizan</groupId>
            <artifactId>bartizan-api</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-command</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-item</artifactId>
        </dependency>
        <!-- NpcWeaponControllerImpl implements NpcWeaponController extends keystone-npc's NpcRangedAttack SPI
             interface (bartizan.md §1.6(8)/§B17). bartizan-api declares this at `provided` scope, which Maven does
             NOT propagate transitively to a dependent module — without this entry javac cannot resolve
             NpcRangedAttack's class file when compiling any class that implements NpcWeaponController, and (as
             observed while writing B17/B20) a single unresolved supertype like this can cascade into spurious
             "cannot find symbol: variable log" errors across unrelated Lombok-processed classes in the same
             compilation round. Same "brings citizens-main transitively at provided scope, never reaches the jar"
             note as bartizan-api's own copy of this dependency. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-npc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-hooks</artifactId>
        </dependency>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- Docket T-09: Bartizan's own code no longer names ViaVersion after the reflective-recoil
             rewrite (§1.6(1) of bartizan.md), but plugin.yml keeps softdepend: [ViaVersion] and the
             trap returns the moment anyone mocks a type that touches it — Mockito's inline mock maker
             retransforms the full type hierarchy of any mocked type, so a com.viaversion field type
             anywhere in that hierarchy throws TypeNotPresentException without this artifact on the
             test classpath. Keep at provided (also reaches the test classpath via the parent's
             dependencyManagement default) — never let this become "unused" and get removed. -->
        <dependency>
            <groupId>com.viaversion</groupId>
            <artifactId>viaversion-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RecordingNbtAccessor / NbtBridge for WeaponItemPredicatesTest (bartizan.md §3, B19) -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
